{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/checks-before-commit.sh",
            "timeout": 120,
            "statusMessage": "The checks before committing"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/checked-before-commit.sh",
            "statusMessage": "A Checked: paragraph with every code or map change"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/review-before-push.sh",
            "timeout": 600,
            "statusMessage": "A second model reviews the push against the rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/checks-before-stop.sh",
            "timeout": 120,
            "statusMessage": "Checking changed code before stopping"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/timeline.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/away-allow.sh",
            "statusMessage": "Away mode: answers prompts while the owner is away"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/timeline.sh"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/here-or-goodnight.sh",
            "statusMessage": "The owner's here and goodnight switches"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/gidi/.claude/hooks/search-first.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(~/.venvs/gidi/bin/python scripts/check_map.py)",
      "Bash(~/.venvs/gidi/bin/python scripts/check_rules.py)",
      "Bash(~/.venvs/gidi/bin/python scripts/working_bar.py *)",
      "Bash(gh run watch *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__list_connected_browsers",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__meshy-mcp-server__meshy_get_task_status",
      "mcp__meshy-mcp-server__meshy_check_balance",
      "mcp__claude_ai_Cloudflare_Developer_Platform__search_cloudflare_documentation"
    ]
  }
}
